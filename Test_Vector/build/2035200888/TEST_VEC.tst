-- Unit: TEST_VEC

-- Subprogram: check_status

-- Test Case: TEST_VEC_R_FTC_003
TEST.UNIT:TEST_VEC
TEST.SUBPROGRAM:check_status
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_003
TEST.COMPOUND_ONLY
TEST.VALUE:TEST_VEC.check_status.temp:100
TEST.VALUE:TEST_VEC.check_status.error_flag:0
TEST.EXPECTED:TEST_VEC.check_status.return:1
TEST.END

-- Test Case: TEST_VEC_R_FTC_004
TEST.UNIT:TEST_VEC
TEST.SUBPROGRAM:check_status
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_004
TEST.COMPOUND_ONLY
TEST.VALUE:TEST_VEC.check_status.error_flag:1
TEST.EXPECTED:TEST_VEC.check_status.return:2
TEST.END

-- Test Case: TEST_VEC_R_FTC_005
TEST.UNIT:TEST_VEC
TEST.SUBPROGRAM:check_status
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_005
TEST.COMPOUND_ONLY
TEST.VALUE:TEST_VEC.check_status.temp:50
TEST.VALUE:TEST_VEC.check_status.voltage:12
TEST.VALUE:TEST_VEC.check_status.error_flag:0
TEST.EXPECTED:TEST_VEC.check_status.return:0
TEST.END

-- Subprogram: divide

-- Test Case: TEST_VEC_R_FTC_001
TEST.UNIT:TEST_VEC
TEST.SUBPROGRAM:divide
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_001
TEST.COMPOUND_ONLY
TEST.EXPECTED:TEST_VEC.divide.return:-1
TEST.END

-- Test Case: TEST_VEC_R_FTC_002
TEST.UNIT:TEST_VEC
TEST.SUBPROGRAM:divide
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_002
TEST.COMPOUND_ONLY
TEST.VALUE:TEST_VEC.divide.b:1
TEST.EXPECTED:TEST_VEC.divide.return:0
TEST.END

-- COMPOUND TESTS

TEST.SUBPROGRAM:<<COMPOUND>>
TEST.NEW
TEST.NAME:TEST_VEC_R_FTC_001
TEST.SLOT: "1", "TEST_VEC", "divide", "1", "TEST_VEC_R_FTC_001"
TEST.END
